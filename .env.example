# Copy .env.example to .env and use instructor-provided classroom credentials.
API_KEY=
AGENT_MODEL=
# Set only when the instructor supplies a compatible Responses API endpoint.
API_BASE_URL=

# Optional provider pricing rates. Costs are omitted when rates are not supplied.
INPUT_COST_PER_1M=
OUTPUT_COST_PER_1M=

# Outer safety caps stay active during the vulnerable starter.
HARD_MAX_MODEL_TURNS=3
HARD_MAX_TOOL_CALLS=3
HARD_MAX_OUTPUT_TOKENS_PER_TURN=512
